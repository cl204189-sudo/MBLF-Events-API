# Exemplo seguro: copie para application.properties (ignorado pelo Git).
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/mblf_events}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:}
spring.jpa.hibernate.ddl-auto=update
jwt.secret=${JWT_SECRET}
app.crypto.key=${APP_CRYPTO_KEY}
app.crypto.hmac-key=${APP_CRYPTO_HMAC_KEY}
